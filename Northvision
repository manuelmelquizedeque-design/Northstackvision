<script>
function setLang(l){
  document.querySelectorAll('.pt').forEach(e=>e.style.display=l==='pt'?'':'none');
  document.querySelectorAll('.en').forEach(e=>e.style.display=l==='en'?'':'none');
  document.querySelectorAll('.lang-btn').forEach(b=>b.classList.toggle('on',b.textContent.trim().toLowerCase()===l));
}
setLang('pt');

const obs=new IntersectionObserver((entries)=>{
  entries.forEach((e,i)=>{if(e.isIntersecting){setTimeout(()=>e.target.classList.add('v'),i*60);obs.unobserve(e.target);}});
},{threshold:.07});
document.querySelectorAll('.fi').forEach(el=>obs.observe(el));

window.addEventListener('scroll',()=>{
  document.querySelector('nav').style.background=window.scrollY>50?'rgba(7,17,31,.98)':'rgba(7,17,31,.92)';
},{ passive:true });

document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{
    e.preventDefault();
    const t=document.querySelector(a.getAttribute('href'));
    if(t)t.scrollIntoView({behavior:'smooth'});
  });
});
</script>
